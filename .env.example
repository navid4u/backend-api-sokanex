# --------------------------------------------------
# HTTPS security
# --------------------------------------------------

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Upload request limit in bytes (550 MB). Nginx must use a matching
# or larger client_max_body_size for direct video uploads.
DATA_UPLOAD_MAX_MEMORY_SIZE=576716800

# Production examples:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
