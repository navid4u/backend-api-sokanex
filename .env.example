# --------------------------------------------------
# Django core
# --------------------------------------------------

SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True

# Comma-separated hosts without http/https
ALLOWED_HOSTS=127.0.0.1,localhost,api.sokanex.com


# --------------------------------------------------
# React frontend / CORS
# --------------------------------------------------

# Comma-separated full frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://sokanex.com,https://www.sokanex.com,https://app.sokanex.com

# Required when Django admin or cookie-based requests
# are sent from another trusted origin.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://sokanex.com,https://www.sokanex.com,https://app.sokanex.com

# OTP provider (server-side only)
PAYAMITO_ENABLED=False
PAYAMITO_USERNAME=
PAYAMITO_API_KEY=
PAYAMITO_FROM_NUMBER=9981803296
PAYAMITO_TIMEOUT_SECONDS=15
PAYAMITO_OTP_MESSAGE_TEMPLATE=کد ورود شما به سوکانکس: {code} - این کد تا ۲ دقیقه معتبر است.
PAYAMITO_NOTIFICATION_MESSAGE_TEMPLATE={title}\n{message}\n{target_url}
PAYAMITO_NOTIFICATION_LINK_BASE_URL=https://app.sokanex.com
PAYAMITO_NOTIFICATION_SMS_MAX_LENGTH=500
PAYAMITO_SMS_RETRY_LIMIT=3
PAYAMITO_SMS_SEND_INLINE=False

# Payment secrets (server-side only)
PAYMENT_PROVIDER_TIMEOUT_SECONDS=15
PAYMENT_PROVIDER_RETRY_LIMIT=1
PAYMENT_CALLBACK_BASE_URL=https://api.sokanex.com
ZARINPAL_MERCHANT_ID=
IDPAY_API_KEY=
IDPAY_SANDBOX=False

# Licensed market-data providers (server-side only; never expose to Vite)
MARKET_DATA_PROVIDER=
MARKET_DATA_PROVIDER_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_SECONDS=8
MARKET_DATA_CACHE_SECONDS=60
MARKET_CHART_TIMEOUT_SECONDS=6
MARKET_CHART_CRYPTO_TTL=90
MARKET_CHART_FOREX_TTL=600
MARKET_CHART_STALE_TTL=86400
MARKET_CHARTS_THROTTLE_RATE=60/minute
FOREX_CHART_PROVIDER_URL=
FOREX_CHART_PROVIDER_KEY=
GOLD_CHART_PROVIDER_URL=
GOLD_CHART_PROVIDER_KEY=
MARKET_DATA_STALE_SECONDS=86400
MARKET_DATA_RETRY_COUNT=1
MARKET_CIRCUIT_BREAKER_FAILURES=3
MARKET_CIRCUIT_BREAKER_SECONDS=60
MARKET_QUOTES_THROTTLE_RATE=60/minute
MARKET_NEWS_THROTTLE_RATE=30/minute
BRSAPI_API_KEY=
BRSAPI_PRICES_IN_RIAL=False
TGJU_ENABLED=False
TGJU_API_URL=https://call5.tgju.org/ajax.json
MARKET_HTTP_USER_AGENT=SokanexBackend/2.0 (+https://sokanex.com)
MARKET_NEWS_TIMEOUT_SECONDS=8
MARKET_NEWS_MAX_BYTES=2097152
MARKET_NEWS_ITEMS_PER_SOURCE=50
ECONOMIC_CALENDAR_PROVIDER=
ECONOMIC_CALENDAR_API_KEY=
REDIS_URL=redis://127.0.0.1:6379/1
CHANNEL_TICKET_TTL_SECONDS=60
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_AUDIO_MB=50
MEDIA_MAX_VIDEO_MB=1024
SUPPORT_USERNAME=support
SUPPORT_MESSAGE_THROTTLE_RATE=30/minute


# --------------------------------------------------
# Database
# --------------------------------------------------

# Development:
DB_ENGINE=sqlite

# Production PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=trading_platform
# DB_USER=trading_user
# DB_PASSWORD=replace-with-secure-password
# DB_HOST=127.0.0.1
# DB_PORT=5432


# --------------------------------------------------
# HTTPS security
# --------------------------------------------------

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Upload request limit in bytes (550 MB). Nginx must use a matching
# or larger client_max_body_size for direct video uploads.
DATA_UPLOAD_MAX_MEMORY_SIZE=576716800

# Production examples:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
