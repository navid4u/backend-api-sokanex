# --------------------------------------------------
# Django core
# --------------------------------------------------

SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True

# Comma-separated hosts without http/https
ALLOWED_HOSTS=127.0.0.1,localhost,api.sokanex.com


# --------------------------------------------------
# React frontend / CORS
# --------------------------------------------------

# Comma-separated full frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://sokanex.com,https://www.sokanex.com,https://app.sokanex.com

# Required when Django admin or cookie-based requests
# are sent from another trusted origin.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://sokanex.com,https://www.sokanex.com,https://app.sokanex.com

# OTP provider (server-side only)
PAYAMITO_ENABLED=False
PAYAMITO_USERNAME=
PAYAMITO_API_KEY=
PAYAMITO_FROM_NUMBER=
PAYAMITO_TIMEOUT_SECONDS=15

# Licensed market-data providers (server-side only; never expose to Vite)
MARKET_DATA_PROVIDER=
MARKET_DATA_PROVIDER_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_TIMEOUT_SECONDS=8
MARKET_DATA_CACHE_SECONDS=60
ECONOMIC_CALENDAR_PROVIDER=
ECONOMIC_CALENDAR_API_KEY=
REDIS_URL=redis://127.0.0.1:6379/1
CHANNEL_TICKET_TTL_SECONDS=60
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_AUDIO_MB=50
MEDIA_MAX_VIDEO_MB=1024
SUPPORT_USERNAME=support
SUPPORT_MESSAGE_THROTTLE_RATE=30/minute


# --------------------------------------------------
# Database
# --------------------------------------------------

# Development:
DB_ENGINE=sqlite

# Production PostgreSQL:
# DB_ENGINE=postgresql
# DB_NAME=trading_platform
# DB_USER=trading_user
# DB_PASSWORD=replace-with-secure-password
# DB_HOST=127.0.0.1
# DB_PORT=5432


# --------------------------------------------------
# HTTPS security
# --------------------------------------------------

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Upload request limit in bytes (550 MB). Nginx must use a matching
# or larger client_max_body_size for direct video uploads.
DATA_UPLOAD_MAX_MEMORY_SIZE=576716800

# Production examples:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
