[Unit]
Description=Run Sokanex SMS automation every five minutes

[Timer]
# Always schedule a fresh first run after the timer is (re)started.
OnActiveSec=2min
# Wait five minutes after each completed worker run before the next batch.
OnUnitInactiveSec=5min
AccuracySec=30s
Unit=sokanex-sms-automation.service

[Install]
WantedBy=timers.target
