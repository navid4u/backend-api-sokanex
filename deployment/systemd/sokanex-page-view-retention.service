[Unit]
Description=Sokanex page-view analytics retention
After=network.target

[Service]
Type=oneshot
User=tradingapp
Group=tradingapp
WorkingDirectory=/srv/trading-platform/backend
ExecStart=/srv/trading-platform/venv/bin/python manage.py purge_page_view_analytics --apply
NoNewPrivileges=true
PrivateTmp=true
