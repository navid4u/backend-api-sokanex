[Unit]
Description=Send queued Sokanex Web Push notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradingapp
Group=tradingapp
WorkingDirectory=/srv/trading-platform/backend
EnvironmentFile=-/srv/trading-platform/backend/.env
ExecStart=/srv/trading-platform/venv/bin/python manage.py send_notification_push --limit 100
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
