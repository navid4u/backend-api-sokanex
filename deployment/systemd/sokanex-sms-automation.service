[Unit]
Description=Queue and send Sokanex SMS automation messages
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradingapp
Group=tradingapp
WorkingDirectory=/srv/trading-platform/backend
# Match the real Gunicorn service's secret EnvironmentFile before enabling this timer.
EnvironmentFile=-/srv/trading-platform/backend/.env
ExecStart=/srv/trading-platform/venv/bin/python manage.py process_sms_automation --limit 100
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
