[Unit]
Description=Send queued private support reply SMS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradingapp
Group=tradingapp
WorkingDirectory=/srv/trading-platform/backend
ExecStart=/srv/trading-platform/venv/bin/python manage.py retry_notification_sms --source-prefix SUPPORT_REPLY:
TimeoutStartSec=180
